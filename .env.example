# ==============================================================================
# Mimi - WhatsApp Scam & Fraud Detection Agent
# Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#      cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
# 2. Fill in your API keys and credentials below.
# 3. WARNING: Never commit your actual .env file with secrets to GitHub!

# ------------------------------------------------------------------------------
# Twilio WhatsApp API Configuration
# ------------------------------------------------------------------------------
# Get your Account SID and Auth Token from the Twilio Console (https://console.twilio.com/)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio WhatsApp sender number in E.164 format with 'whatsapp:' prefix
# For Twilio WhatsApp Sandbox, this is typically: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Optional: Twilio Sandbox join command/keyword (e.g. "join simple-word")
TWILIO_SANDBOX_JOIN=join your-sandbox-keyword

# ------------------------------------------------------------------------------
# Amazon Web Services (AWS) Configuration
# ------------------------------------------------------------------------------
# AWS IAM user credentials with permissions for Amazon Transcribe & Amazon S3
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# S3 bucket name used for temporary audio staging during transcription
# Audio files are purged after processing.
S3_BUCKET_NAME=your-s3-bucket-name

# ------------------------------------------------------------------------------
# VirusTotal API Configuration
# ------------------------------------------------------------------------------
# API Key from VirusTotal (https://www.virustotal.com/gui/my-apikey)
# Used for scanning suspicious URLs, attachments, and APK hashes
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ------------------------------------------------------------------------------
# Groq API Configuration
# ------------------------------------------------------------------------------
# API key from Groq Console (https://console.groq.com/keys)
# Powers ultra-fast multi-modal reasoning and multilingual processing
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM model name (default recommended: qwen/qwen3.8-27b or llama-3.3-70b-versatile)
GROQ_MODEL=qwen/qwen3.8-27b

# Whisper model name for audio transcription via Groq (optional, default: whisper-large-v3-turbo)
WHISPER_MODEL=whisper-large-v3-turbo

# ------------------------------------------------------------------------------
# Trusted Contact / Emergency Fallback Configuration
# ------------------------------------------------------------------------------
# Default emergency contact phone number in E.164 format (with whatsapp: prefix)
# Used to alert family/support when high-confidence scams or urgent danger is detected.
# Example: whatsapp:+14155552671 or whatsapp:+919876543210
TRUSTED_CONTACT_NUMBER=whatsapp:+10000000000
